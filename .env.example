APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://tanbat.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tanbat_x
DB_USERNAME=root
DB_PASSWORD=

# Legacy Sngine article migration (optional; only for legacy:import-articles)
LEGACY_DB_DATABASE=tanbat_old
LEGACY_UPLOADS_BASE=https://tanbat.com/content/uploads
LEGACY_DEFAULT_AUTHOR_ID=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Groq (used by the BabyBoss chat persona)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT=25

# BabyBoss system user — handle (username) of the in-app book finder persona.
BABYBOSS_USERNAME=babyboss
# Path to the file with three search URL templates (one per line, "sample book" placeholder).
BABYBOSS_URLS_PATH=
# Social handle BabyBoss asks for a shoutout on when the book is found.
BABYBOSS_SHOUTOUT_HANDLE=tanbat

# Reddit cross-poster — script-type app from https://www.reddit.com/prefs/apps
REDDIT_ENABLED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT="Tanbat/1.0 by your_reddit_username"
REDDIT_SUBREDDIT=pdfbooks
REDDIT_POST_SPACING_MINUTES=20

# Pinterest cross-poster — OAuth web app from https://developers.pinterest.com/apps/
# Register redirect URI on the app (HTTPS, exact match): {APP_URL}/admin/pinterest/callback
PINTEREST_ENABLED=false
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=
PINTEREST_API_HOST=https://api.pinterest.com
PINTEREST_POST_SPACING_MINUTES=20

# Telegram channel cross-poster. The bot must be an ADMIN of the target channel
# with "Post Messages" permission. Also settable at /admin/telegram.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SITE_URL=https://tanbat.com
TELEGRAM_POST_SPACING_MINUTES=5

# Book RSS importer — publishes new feed entries as anonymous book posts.
BOOK_RSS_ENABLED=false
BOOK_RSS_FEED_URL=
BOOK_RSS_POLL_MINUTES=60
BOOK_RSS_MAX_PER_RUN=10
TELEGRAM_VERIFY_SSL=true
